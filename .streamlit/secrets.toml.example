# Copy this to .streamlit/secrets.toml for local testing, or paste the same
# key/value pairs into the "Secrets" box when deploying on Streamlit
# Community Cloud (Settings -> Secrets). Streamlit exposes these as both
# st.secrets and os.environ, so pydantic-settings picks them up as-is.

OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "nvidia/nemotron-3-super-120b-a12b:free"
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"

# Optional
LANGSMITH_TRACING = "false"
LANGSMITH_API_KEY = ""
