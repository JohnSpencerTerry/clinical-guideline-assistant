# LangSmith tracing (wired from day one per mvp.md Phase 0)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinical-guideline-assistant

# Model provider — OpenRouter (OpenAI-compatible API), chosen for free-tier
# and low-cost models. Get a key at https://openrouter.ai/keys and pick a
# model id from https://openrouter.ai/models (":free" suffix = no cost).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Vector store
VECTOR_STORE_DIR=./data/processed/chroma
